# LogiNaft Smart System - Client Environment Variables

# In Local Development:
# Leave empty to let the Vite development server proxy requests to http://localhost:5000
# VITE_API_BASE_URL=

# In Production on Vercel:
# Set this to your Render backend API URL (e.g. https://loginaft-server.onrender.com/api)
VITE_API_BASE_URL=https://loginaft-server.onrender.com/api

# Optional: Override Socket.IO server URL (defaults to origin of VITE_API_BASE_URL)
# VITE_SOCKET_URL=https://loginaft-server.onrender.com
